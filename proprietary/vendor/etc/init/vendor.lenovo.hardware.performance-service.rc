service performance /vendor/bin/hw/vendor.lenovo.hardware.performance-service
    class hal
    user system
    group system

on post-fs
    chown system system /sys/devices/system/cpu/cpu0/thermal/control
    chmod 0660 /sys/devices/system/cpu/cpu0/thermal/control

    # CPU scheduler
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    chown system system /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor
    chown system system /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor
    chown system system /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor
    chown system system /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor
    chown system system /sys/devices/system/cpu/cpu5/cpufreq/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpu5/cpufreq/scaling_governor
    chown system system /sys/devices/system/cpu/cpu6/cpufreq/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpu6/cpufreq/scaling_governor
    chown system system /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor
