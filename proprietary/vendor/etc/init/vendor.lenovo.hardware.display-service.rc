#add node perms for different plat
# eldenw code for ELDENW-640 by jiangyue10 at 2025/09/11 start
on post-fs-data
    chown system system /sys/devices/platform/soc/af54000.qcom,dp_display/prefer_mode
    chown system system /sys/devices/platform/soc/af54000.qcom,dp_display/hpd_sim
    chown system system /sys/devices/platform/soc/af54000.qcom,dp_display/mode_index
    chmod 0660 /sys/devices/platform/soc/af54000.qcom,dp_display/prefer_mode
    chmod 0660 /sys/devices/platform/soc/af54000.qcom,dp_display/hpd_sim
    chmod 0660 /sys/devices/platform/soc/af54000.qcom,dp_display/mode_index
# eldenw code for ELDENW-640 by jiangyue10 at 2025/09/11 end
service display_aidl_service /vendor/bin/hw/vendor.lenovo.hardware.display-service
    class hal
    user system
    group system
